__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# captured data and generated reports
*.npz
*.csv
*.h5
captures/
octobee_cal.png
smoketest*.png

# Where each axis was left, so position trust survives a restart. State, not
# configuration: it describes one machine at one moment and means nothing on
# another bench, so it lives beside the config without being any of it.
config/stage_state.json

# local configuration overrides. For a whole alternative set, point
# $OCTOBEE_CONFIG_DIR at another directory instead of editing these.
config/*_local.json
octobee_launch_error.log

# on-box firmware/config snapshots (contain private keys and password hashes)
fw_backup_*/
octobee_crash.log

# pytest
.pytest_cache/

# PowerShell redirect accidents. "2>$null" is correct in PowerShell, but
# escaped or quoted wrongly it creates a file with that literal name --
# and NUL is the same trap. Neither is ever a file this project wants.
$null
NUL
