# DEFAULT init for acq423, 200000 Hz, auto soft trigger
#
# created by deploy_sysconfig for uut:acq1001_695 mezz:acq423
# by dt100@eigg-fs on Thu 11 Sep 15:11:15 BST 2025
# git dfd3753558f321e924fae47dea28d1803192bfa4
# incant ./deploy_sysconfig.sh acq1001_695 acq423 1

/usr/local/CARE/acq1001\+acq42x.init
# Local clock and soft trigger
set.site 0 sync_role master 200000
# Alternate front panel clock and front panel trigger
#set.site 0 sync_role fpmaster 200000 1000000

# For other combinations try 'set.site 0 sync_role help'

judgement() {
# short trace length, rapid update 50Hz possible
set.site 1 RTM_TRANSLEN ${1:-128}
set.site 1 RGM RTM
set.site 1 RGM:DX ${2:-d0}
set.site 1 RGM:SENSE rising
}
# see /mnt/local/sysconfig/epics.sh
source /mnt/local/sysconfig/acq400.sh
[ ! -z "$ACQ400_JUDGEMENT" ] && judgement $ACQ400_JUDGEMENT

# Set trigger source for SPAD uSec counter; soft_trigger same as ADC default trigger
set.site 0 spad1_us 1,1,1

# Power good monitoring for connected SENIS sensors
# Checks once upon boot
/mnt/local/pgood_spad

# Enable I2C temperature ADC poll and include in SPAD2-6
/mnt/local/temps_spad &

# enable port 4210 stream
echo STREAM_OPTS= >> /etc/sysconfig/acq400_streamd.conf

# --- sensor gain -------------------------------------------------------------
# Deliberately NOT set here. The gain lives in each SENM3Dx's own EEPROM byte
# EGain_sel (0x10E), which the chip loads at power-up along with that chip's
# factory calibration trims for the selected gain. All 16 chips are set to
# EGain_sel=0x00 -> gain 3000 (+/-20 mT, 63 V/T).  [2026-08-19]
#
# A boot-time 'set-device-gain.py' loop used to live here on acq1001_695. It was
# removed on purpose: it only forces the GAIN, not the calibration trims, so if
# an EEPROM ever went invalid the chip would boot to datasheet defaults (no
# trims) and the loop would make the gain look correct anyway -- hiding exactly
# the fault you want to see. With no loop, a bad EEPROM shows up immediately as
# gain 1500 in:  python3 /tmp/onbox_gain_config.py verify --gain 3000
#
# To change gain, change the EEPROM (this also loads that gain's trim set):
#     python3 onbox_gain_config.py set --gain <15|150|1500|3000>
#     python3 onbox_gain_config.py verify --gain <same>
# -----------------------------------------------------------------------------
